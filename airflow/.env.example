# Copy to .env (git-ignored) and fill in; see the commands in the README/steps.

# Files created by Airflow belong to this user, not root.
AIRFLOW_UID=
# Group of /var/run/docker.sock: lets Airflow talk to the host's Docker.
DOCKER_GID=
# Absolute path of this repository on the host (used for the data volume).
HOST_PROJECT_DIR=

# Generated secrets: never reuse across machines.
FERNET_KEY=
API_SECRET_KEY=
JWT_SECRET=
